    </style>
</head>
<body>
    <div class="container">
        <h1>⚡ NEXUS EXTENSION DRAWER</h1>
        <p>Ton extension est prête à être chargée dans Firefox.</p>
        
        <div class="steps">
            <h3>Comment l'installer :</h3>
            <ul>
                <li>1. Ouvre Firefox et tape <code>about:debugging</code> dans la barre d'adresse.</li>
                <li>2. Clique sur <b>"Ce Firefox"</b> (This Firefox) à gauche.</li>
                <li>3. Clique sur <b>"Charger un module temporaire..."</b>.</li>
                <li>4. Sélectionne le fichier : <code>/tmp/nexus-extension-drawer/manifest.json</code></li>
                <li>5. Clique sur l'icône de l'extension dans ta barre d'outils. 🎉</li>
            </ul>
        </div>
        
        <div style="margin-top: 20px; color: #666; font-size: 0.8rem;">
            <p>Le dossier de l'extension est situé dans : <code>/tmp/nexus-extension-drawer/</code></p>
            <p>Généré par <b>NEXUS</b> — Aissa Mohammedi (DGK)</p>
        </div>
    </div>
</body>
</html>
HTML_PREVIEW

echo -e "  \033[1;32m[✓]\033[0m Extension générée dans : \033[1;36m$EXT_DIR\033[0m"
echo -e "  \033[1;32m[✓]\033[0m Preview disponible sur : \033[4mhttp://localhost:$PORT\033[0m"

# 8. Serveur HTTP pour la prévisualisation
handle_request() {
    local request_line
    read -r request_line
    local path=$(echo "$request_line" | awk '{print $2}')
    while IFS= read -r line && [[ -n "$line" && "$line" != $'\r' ]]; do :; done

    if [[ "$path" == "/" || "$path" == "/index.html" ]]; then
        local len=$(wc -c < "$HTML_FILE")
        printf 'HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\nConnection: close\r\n\r\n' "$len"
        cat "$HTML_FILE"
    else
        printf 'HTTP/1.1 404 Not Found\r\n\r\n404'
    fi
}
export -f handle_request
export HTML_FILE

# Lancer le serveur en arrière-plan
echo -e "\n  \033[1;33mCtrl+C pour arrêter le serveur.\033[0m\n"
trap 'echo -e "\n\033[1;31m[✗] Serveur arrêté.\033[0m"; exit 0' INT TERM

if command -v xdg-open >/dev/null 2>&1; then
    sleep 1
    xdg-open "http://localhost:$PORT" &
fi

if command -v socat >/dev/null 2>&1; then
    socat TCP-LISTEN:$PORT,reuseaddr,fork EXEC:"bash -c 'handle_request'"
elif command -v nc >/dev/null 2>&1; then
    while true; do nc -l -p $PORT -c "bash -c 'handle_request'" 2>/dev/null || nc -l -p $PORT < /dev/null | bash -c 'handle_request'; done
else
    echo "Erreur : installer socat ou netcat."
    exit 1
fi
